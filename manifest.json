{
  "id": "ink.kei.arknights",
  "name": "Arknights",
  "version": "0.1.0",
  "description": "明日方舟玩家个人信息展示",
  "locales": {
    "en-US": { "name": "Arknights", "description": "Arknights player profile viewer" }
  },
  "category": "data",
  "main": "main.js",
  "author": {
    "name": "Leaphy"
  },
  "permissions": [
    "storage:read",
    "storage:write",
    "network:fetch",
    "ui:notification",
    "ui:theme",
    "ui:confirm"
  ],
  "hasPage": true,
  "pageTemplate": "page.html",
  "pageModules": ["crypto.js", "skland.js", "assets.js", "app.js", "home.js", "debug.js"],
  "styles": "styles.css",
  "cssMode": "unified",
  "assets": [
    "assets/avatar.webp",
    "assets/skills.jpg",
    "assets/character_table.json",
    "assets/avatar_map.json",
    "assets/skill_map.json",
    "assets/rank/elite0.png",
    "assets/rank/elite1.png",
    "assets/rank/elite2.png"
  ],
  "settings": [
    {
      "key": "sklandToken",
      "type": "input",
      "label": "森空岛 Token",
      "description": "格式：cred,token",
      "placeholder": "cred,token"
    }
  ],
  "apis": {
    "sklandPlayerBinding": {
      "type": "http",
      "access": "protected",
      "endpoint": "https://zonai.skland.com/api/v1/game/player/binding",
      "method": "GET",
      "description": "森空岛玩家绑定账号列表",
      "headers": {
        "platform": "{{params.platform}}",
        "timestamp": "{{params.timestamp}}",
        "dId": "{{params.dId}}",
        "vName": "{{params.vName}}",
        "cred": "{{params.cred}}",
        "sign": "{{params.sign}}"
      }
    },
    "sklandPlayerInfo": {
      "type": "http",
      "access": "protected",
      "endpoint": "https://zonai.skland.com/api/v1/game/player/info?uid={{params.uid}}",
      "method": "GET",
      "description": "森空岛玩家信息（含博士等级与干员）",
      "headers": {
        "platform": "{{params.platform}}",
        "timestamp": "{{params.timestamp}}",
        "dId": "{{params.dId}}",
        "vName": "{{params.vName}}",
        "cred": "{{params.cred}}",
        "sign": "{{params.sign}}"
      }
    },
    "sklandCultivate": {
      "type": "http",
      "access": "protected",
      "endpoint": "https://zonai.skland.com/api/v1/game/cultivate/player?uid={{params.uid}}",
      "method": "GET",
      "description": "森空岛仓库材料与干员养成数据",
      "headers": {
        "platform": "{{params.platform}}",
        "timestamp": "{{params.timestamp}}",
        "dId": "{{params.dId}}",
        "vName": "{{params.vName}}",
        "cred": "{{params.cred}}",
        "sign": "{{params.sign}}"
      }
    }
  }
}
